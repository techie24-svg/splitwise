{
  "name": "reverse-engineering",
  "version": "1.0.0",
  "description": "A dedicated workspace for inspecting application architecture, analyzing features without original source code, and reconstructing clean, compatible implementations.",
  "main": "src/demo.ts",
  "type": "module",
  "scripts": {
    "build": "esbuild src/vercel-handler.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types src/db/seed.ts",
    "test": "node --experimental-strip-types tests/simplifyDebts.test.ts && node --experimental-strip-types tests/database.test.ts",
    "demo": "node --experimental-strip-types src/demo.ts"
  },
  "keywords": [
    "splitwise",
    "expense-splitter",
    "debt-simplification",
    "min-cash-flow"
  ],
  "author": "techie24-svg <yash240391@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "rea-agents": "^6.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.2"
  }
}
